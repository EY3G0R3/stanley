#!/usr/bin/env python3
"""Popups for stanley's blocks on the dwl bar.

    stanley-popup network|bluetooth|audio|power|tmp|agents|cpu|memory|disk|messages|record

Running it again with the same name closes the open popup; another name
replaces it. A popup closes on Esc or a click outside it. With BLOCK_X and
BLOCK_WIDTH set, as stanley sets them for a click, it opens under the block.

Drawn with GTK4 and gtk4-layer-shell (apt: gir1.2-gtk4layershell-1.0). The
window covers the work area below the bar and is transparent apart from the
card, so a click anywhere else on screen lands on it and closes it. Each popup
is a module beside this file; common.py has what they share.
"""

import ctypes.util
import os
import shutil
import signal
import subprocess
import sys

# gtk4-layer-shell has to be loaded before libwayland-client, which Python
# cannot arrange after start-up, so the script re-executes itself once with
# the library preloaded. The variable is dropped again so the programs the
# popups launch do not inherit it.
LIB = ctypes.util.find_library("gtk4-layer-shell")
if LIB and LIB not in os.environ.get("LD_PRELOAD", ""):
    os.environ["LD_PRELOAD"] = LIB
    os.execv(sys.executable, [sys.executable] + sys.argv)
os.environ.pop("LD_PRELOAD", None)

# The popup modules live beside this file, which is normally run through a
# symlink in ~/.local/bin. common goes first: it selects the GTK versions.
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from common import CSS, Tab, place  # noqa: E402
from gi.repository import Gdk, Gio, GLib, GLibUnix, Gtk  # noqa: E402
from gi.repository import Gtk4LayerShell as LayerShell  # noqa: E402

from agents import Agents  # noqa: E402
from audio import Audio  # noqa: E402
from bluetooth import Bluetooth  # noqa: E402
from cpu import Cpu  # noqa: E402
from disk import Disk  # noqa: E402
from memory import Memory  # noqa: E402
from messages import Messages  # noqa: E402
from network import Network  # noqa: E402
from power import Power  # noqa: E402
from record import Record  # noqa: E402
from tmp import Tmp  # noqa: E402

CLASSES = dict(network=Network, bluetooth=Bluetooth, audio=Audio, power=Power, tmp=Tmp, agents=Agents,
               cpu=Cpu, memory=Memory, disk=Disk, messages=Messages, record=Record)
POPUPS = tuple(CLASSES)
STATE = os.path.join(os.environ.get("XDG_RUNTIME_DIR", "/tmp"), "stanley-popup")


# ------------------------------------------------------------- quickshell

# Omarchy's shell has its own panels for these, by plugin id. It opens a panel
# only from its own live bar widget, so under dwl it runs with that bar
# hidden. stanley starts before dwl and keeps the outer WAYLAND_DISPLAY,
# hence --any-display. STANLEY_POPUPS=python keeps them here instead.
QUICKSHELL = {"network": "omarchy.network", "bluetooth": "omarchy.bluetooth",
              "power": "omarchy.power", "tmp": "igorg.tmp-quota", "agents": "omarchy.agents"}


def quickshell(name):
    """Toggle Omarchy's panel for name where its shell runs; False if not."""
    shell = os.environ.get("STANLEY_QUICKSHELL", "/usr/share/omarchy/shell")
    if (os.environ.get("STANLEY_POPUPS") == "python" or name not in QUICKSHELL
            or not shutil.which("quickshell") or not os.path.isdir(shell)):
        return False
    subprocess.run(["quickshell", "ipc", "-p", shell, "--any-display", "call", "shell",
                    "toggle", QUICKSHELL[name], ""],
                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    return True


# ------------------------------------------------------------- toggling

def take_over(name):
    """Close a popup that is already open; return False to stay closed."""
    try:
        pid_s, other = open(STATE).read().split()
        pid = int(pid_s)
        if "stanley-popup" in open(f"/proc/{pid}/cmdline").read():
            os.kill(pid, signal.SIGTERM)
            if other == name:
                os.unlink(STATE)
                return False
    except (OSError, ValueError):
        pass
    with open(STATE, "w") as f:
        f.write(f"{os.getpid()} {name}\n")
    return True


def release():
    try:
        if open(STATE).read().split()[0] == str(os.getpid()):
            os.unlink(STATE)
    except (OSError, IndexError):
        pass


class App(Gtk.Application):
    def __init__(self, name):
        super().__init__(application_id=None, flags=Gio.ApplicationFlags.NON_UNIQUE)
        self.name = name

    def do_activate(self):
        # dwl draws the bar at 96 dpi times the output scale, which GTK applies
        # too. Omarchy's text-scaling-factor (1.36) would make 16pt here half
        # as big again as 16pt on the bar, so this process opts out of it.
        Gtk.Settings.get_default().set_property("gtk-xft-dpi", 96 * 1024)
        provider = Gtk.CssProvider()
        provider.load_from_string(CSS)
        Gtk.StyleContext.add_provider_for_display(
            Gdk.Display.get_default(), provider, Gtk.STYLE_PROVIDER_PRIORITY_USER)

        win = Gtk.ApplicationWindow(application=self)
        win.add_css_class("root")
        LayerShell.init_for_window(win)
        LayerShell.set_namespace(win, "stanley-popup")
        LayerShell.set_layer(win, LayerShell.Layer.TOP)
        for edge in (LayerShell.Edge.TOP, LayerShell.Edge.BOTTOM,
                     LayerShell.Edge.LEFT, LayerShell.Edge.RIGHT):
            LayerShell.set_anchor(win, edge, True)
        LayerShell.set_exclusive_zone(win, 0)
        # On-demand, not exclusive: dwl ignores bar clicks while a layer
        # surface holds the keyboard exclusively, which would stop the icon
        # from closing its own popup. dwl's sloppy focus still hands this
        # window the keyboard once the pointer moves onto it, so Esc works.
        LayerShell.set_keyboard_mode(win, LayerShell.KeyboardMode.ON_DEMAND)

        inner = CLASSES[self.name](self).widget()
        inner.set_size_request(360, -1)
        card = Tab(inner)
        # Slide down out of the bar rather than appearing in place.
        reveal = Gtk.Revealer(transition_type=Gtk.RevealerTransitionType.SLIDE_DOWN,
                              transition_duration=160, valign=Gtk.Align.START)
        reveal.set_child(card)
        win.set_child(reveal)
        place(reveal, card)
        GLib.timeout_add(16, lambda: reveal.set_reveal_child(True))

        keys = Gtk.EventControllerKey()
        keys.connect("key-pressed", lambda _c, kv, *_: (self.quit(), True)[1]
                     if kv == Gdk.KEY_Escape else False)
        win.add_controller(keys)

        click = Gtk.GestureClick(button=0)
        click.set_propagation_phase(Gtk.PropagationPhase.CAPTURE)

        def pressed(_g, _n, x, y):
            hit = win.pick(x, y, Gtk.PickFlags.DEFAULT)
            while hit is not None and hit is not card:
                hit = hit.get_parent()
            if hit is None:
                self.quit()
        click.connect("pressed", pressed)
        win.add_controller(click)
        win.present()


def main():
    if len(sys.argv) != 2 or sys.argv[1] not in POPUPS:
        sys.exit(f"usage: stanley-popup {'|'.join(POPUPS)}")
    if not LIB:
        sys.exit("stanley-popup: install gir1.2-gtk4layershell-1.0")
    name = sys.argv[1]
    if quickshell(name):
        return
    if not take_over(name):
        return
    app = App(name)
    GLibUnix.signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM, lambda: (app.quit(), False)[1])
    try:
        app.run([sys.argv[0]])
    finally:
        release()


if __name__ == "__main__":
    main()
